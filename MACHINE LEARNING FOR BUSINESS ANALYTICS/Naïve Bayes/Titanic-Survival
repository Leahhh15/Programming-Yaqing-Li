##################################
## Naïve Bayes-Titanic Survival ##
## Dataset: titanic_hw.csv      ##
##################################

#1 Download a csv file named "titanic_hw.csv" that includes data for 714 passengers. Read the file for the analysis. Name the data frame as "titanic.df". There should be some empty cells in the csv file. When you read the file, make sure that empty cells read as missing values. Report the dimension of titanic.df.
titanic.df <- read.csv("titanic_hw.csv", na.strings = "")
dim(titanic.df)

#2 Report the first 10 rows of titanic.df.
head(titanic.df, n = 10)

#3 Report the brief summary of attributes in titanic.df.
str(titanic.df)

#4 Report the number of missing values in each column of titanic.df.
colSums(is.na(titanic.df))

#5 Add a new attribute named AgeG by converting Age into the Factor type after creating bins as follows:
# Age < 10  -> 0
# 10 < Age < 20 -> 1
# 20 < Age < 30 -> 2
# 30 < Age < 40 -> 3
# ...
# 70 < Age < 80 -> 7
# Report the results of summary(titanic.df$AgeG).
titanic.df$AgeG <- factor(floor(titanic.df$Age / 10))
levels(titanic.df$AgeG)

#6 Convert data types of variables to factors, if necessary. Report the data type of Pclass, Sex, and Survived.
titanic.df$Pclass <- factor(titanic.df$Pclass)
titanic.df$Sex <- factor(titanic.df$Sex)
titanic.df$Survived <- factor(titanic.df$Survived)
str(titanic.df$Pclass)
str(titanic.df$Sex)
str(titanic.df$Survived)

#7 Partition the data into training (70%) and validation (30%) data. Use set.seed(2) to get the same partitions when re-running the R code. Report the dimension (the number of rows and columns) for each of the training and validation dataset.
selected.var <- c("Pclass", "Sex", "AgeG", "Survived")
set.seed(2)
train.index <- sample(1:dim(titanic.df)[1], dim(titanic.df)[1] * 0.7)
train.df <- titanic.df[train.index, selected.var]
dim(train.df)
valid.df <- titanic.df[-train.index, selected.var]
dim(valid.df)

#8 Run naive Bayes on the training data. Report predicted probabilities for "0" (died) and "1" (survived) and predicted class for the first 10 records in the valid data.
library(e1071)
titanic.nb <- naiveBayes(Survived ~ ., data = train.df)
pred.prob <- predict(titanic.nb, newdata = valid.df, type = "raw")
pred.class <- predict(titanic.nb, newdata = valid.df)
head(pred.prob, n = 10)
head(pred.class, n = 10)

#9 Report actual class, predicted class, and predicted probabilities of the following record in the valid data:
# Sex = "male", Pclass = "3" and AgeG = "3"
df <- data.frame(actual = valid.df$Survived, predicted = pred.class, pred.prob)
df[valid.df$Sex == "male" & valid.df$Pclass == "3" & valid.df$AgeG == "3", ]

#10 Assume that someone asks you to predict whether passengers with the following characteristics could have survived.
# Sex    Pclass    Age
# female 3         37
# male   2         57
# male   2         21
# To answer the question, report predicted classes of the following passengers.
new.df <- data.frame(Sex = c("female", "male", "male"),
                     Pclass = c(3, 2, 2),
                     Age = c(37, 57, 21))

new.df$Sex <- factor(new.df$Sex)
new.df$Pclass <- factor(new.df$Pclass)
new.df$AgeG <- factor(floor(new.df$Age / 10))

pred.prob.new <- predict(titanic.nb, newdata = new.df, type = "raw")
pred.prob.new

pred.class.new <- predict(titanic.nb, newdata = new.df)
pred.class.new

#11 Plot ROC curve.
library(pROC)
ROC_predictions <- roc((ifelse(valid.df$Survived == "1", 1, 0)), pred.prob[, 1])
plot(ROC_predictions, col = "blue")

#12 Report AUC.
auc(ROC_predictions)

#13 Plot a lift chart.
library(gains)
gain <- gains(ifelse(valid.df$Survived == "1", 1, 0), pred.prob[, 1], groups = 10)
gain

plot(c(0, gain$cume.pct.of.total * sum(valid.df$Survived == "1")) ~ c(0, gain$cume.obs),
     xlab = "# cases", ylab = "Cumulative", main = "Lift Chart", type = "l")
lines(c(0, sum(valid.df$Survived == "1")) ~ c(0, dim(valid.df)[1]), lty = 2)

#14 Report confusion matrix and accuracy using train data.
library(caret)
pred.class <- predict(titanic.nb, newdata = train.df)
confusionMatrix(pred.class, train.df$Survived)

#15 Report confusion matrix and accuracy using valid data.
pred.class <- predict(titanic.nb, newdata = valid.df)
confusionMatrix(pred.class, valid.df$Survived)
